# This file is a template only. Do not put a real API key here.
# The application reads OPENAI_API_KEY from the process environment.
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI-compatible relay endpoint. Keep the /v1 suffix when required by the relay.
OPENAI_BASE_URL=https://stariver.top/v1

# Optional: override the model selected by the application.
OPENAI_MODEL=gpt-5.6-luna
